@inject IWebHostEnvironment Env
@code {
    private static string? _cachedVersion;
    private string AppVersion
    {
        get
        {
            if (_cachedVersion != null) return _cachedVersion;
            try
            {
                var path = System.IO.Path.Combine(Env.WebRootPath, "app.js");
                var ticks = System.IO.File.GetLastWriteTimeUtc(path).Ticks;
                _cachedVersion = ticks.ToString("x");
            }
            catch
            {
                _cachedVersion = System.DateTime.UtcNow.Ticks.ToString("x");
            }
            return _cachedVersion;
        }
    }
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="bootstrap/bootstrap-icons-1.13.1/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="IntegracaoCieloEcommerceSandbox.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="app.js?v=@AppVersion"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
