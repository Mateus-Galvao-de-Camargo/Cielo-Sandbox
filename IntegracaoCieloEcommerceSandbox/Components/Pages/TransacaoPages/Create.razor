@page "/transacoes/create"

@using Microsoft.EntityFrameworkCore
@using Newtonsoft.Json
@using IntegracaoCieloEcommerceSandbox.Models
@using IntegracaoCieloEcommerceSandbox.Data
@using IntegracaoCieloEcommerceSandbox.Services
@using IntegracaoCieloEcommerceSandbox.Exceptions
@inject TransacaoService TransacaoService
@inject AppDbContext DbContext
@inject NavigationManager NavigationManager


<PageTitle>Transação</PageTitle>

<h1>Criar Transação</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Transacao" OnValidSubmit="AddTransacao" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />
            <div class="mb-3">
                <label for="valor" class="form-label">Valor:</label>
                <input id="valor" type="text" class="form-control"
                       value="@FormatarValorParaExibicao(Transacao.Valor)"
                       inputmode="numeric"
                       autocomplete="off"
                       data-currency-mask />
                <InputNumber @bind-Value="Transacao.Valor" data-currency-value style="display:none" tabindex="-1" aria-hidden="true" />
                <ValidationMessage For="() => Transacao.Valor" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="cartaoId" class="form-label">Selecione o Cartão:</label>
                <InputSelect id="cartaoId" @bind-Value="Transacao.CartaoId" class="form-control">
                    <option value="0">-- Selecione um cartão --</option>
                    @foreach (var cartao in cartoes)
                    {
                        <option value="@cartao.Id">@cartao.NumeroDoCartao - @cartao.NomeNoCartao</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Transacao.CartaoId" class="text-danger" />
            </div>

            <button id="submitButton" type="submit" class="btn btn-primary btn-sm me-2">Criar</button>
            <a class="btn btn-secondary btn-sm me-2" href="/transacoes"><i class="bi bi-arrow-left"></i>Voltar pra lista</a>
        </EditForm>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger">@mensagemErro</div>
}

@code {

    [SupplyParameterFromForm]
    public Transacao Transacao { get; set; } = new();
    private List<Cartao> cartoes = new List<Cartao>();
    private string? mensagemErro;
    private bool isProcessing;
    private bool navegar;

    private static string FormatarValorParaExibicao(double valor)
    {
        var cents = (long)Math.Round(valor * 100, MidpointRounding.AwayFromZero);
        if (cents < 0) cents = 0;
        var reais = cents / 100;
        var centavos = cents % 100;
        var cultureBR = new System.Globalization.CultureInfo("pt-BR");
        return $"R$ {reais.ToString("N0", cultureBR)},{centavos:D2}";
    }

    protected override async Task OnInitializedAsync()
    {
        cartoes = await DbContext.Cartoes.ToListAsync();
    }

    public async Task AddTransacao()
    {
        try
        {
            if (isProcessing)
            {
                return;
            }
            
            isProcessing = true;

            if (Transacao.CartaoId <= 0)
            {
                mensagemErro = "Por favor, selecione um cartão.";
                return;
            }

            await TransacaoService.CreateTransacao(Transacao, Transacao.CartaoId);

            navegar = true;
        }
        catch (EntityLimitExceededException ex)
        {
            mensagemErro = ex.Message;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Ocorreu um erro: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            if (navegar)
            {
                NavigationManager.NavigateTo("/transacoes");
            }
        }
    }
}
